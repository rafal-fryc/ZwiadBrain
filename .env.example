# Copy to .env (gitignored) and fill in. All accounts are free.

# api.data.gov key — works for Congress.gov v3. Sign up: https://api.data.gov/signup/
CONGRESS_API_KEY=

# api.data.gov key — works for GovInfo. May be the same as CONGRESS_API_KEY. Sign up: https://api.data.gov/signup/
GOVINFO_API_KEY=

# LegiScan account key (state bills). Sign up: https://legiscan.com/legiscan
LEGISCAN_API_KEY=

# Anthropic API key (Claude). https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Absolute path to the local, read-only law brain (commentary + Further Reading link harvest).
# Overrides [lawbrain].path in zwiadbrain.toml. Read-only: ZwiadBrain never edits the law brain.
LAW_BRAIN_PATH=/path/to/Brains/law
