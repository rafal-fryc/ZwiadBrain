# Copy to .env (gitignored) and fill in. All accounts are free.

# api.data.gov key — works for BOTH Congress.gov v3 and GovInfo. Sign up: https://api.data.gov/signup/
CONGRESS_API_KEY=

# LegiScan account key (state bills). Sign up: https://legiscan.com/legiscan
LEGISCAN_API_KEY=

# Anthropic API key (Claude). https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Absolute path to the local, read-only law brain. Overrides [lawbrain].path in zwiadbrain.toml.
LAW_BRAIN_PATH=C:/Users/rafst/Documents/projectas/Brains/law
